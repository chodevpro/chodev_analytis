{
  "name": "@chodev/analytics",
  "version": "1.0.0",
  "description": "Lightweight, cross-platform Analytics and Remote Config SDK for Website, React, Next.js, and React Native",
  "author": "Chợ Dev <contact@chodev.pro>",
  "license": "MIT",
  "homepage": "https://chodev.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/chodevpro/chodev_analytis.git"
  },
  "keywords": [
    "analytics",
    "telemetry",
    "web-analytics",
    "react-native",
    "nextjs",
    "react",
    "expo",
    "feature-flags",
    "remote-config",
    "chodev"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.mjs",
      "require": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "npx --prefix ../../fe_chodev tsx --test tests/analytics.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
